# /etc/systemd/system/lyntrix.service
[Unit]
Description=LYNTRIX website (Node server)
After=network.target

[Service]
Type=simple
User=lyntrix
WorkingDirectory=/home/lyntrix/lyntrixtec
EnvironmentFile=/home/lyntrix/lyntrixtec/.env
Environment=NODE_ENV=production PORT=3000 HOST=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
