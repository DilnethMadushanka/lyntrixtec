rules_version = '2';

// Lyntrix Cloud Firestore rules.
//
// The site authenticates users itself (records in `users` / `admins`) rather than through
// Firebase Auth, so the browser needs open access to these collections, the same access the
// old Supabase "public read/write" policies granted. Every other path is denied.
//
// WARNING: this means anyone holding the public web config can read and write these collections,
// including stored passwords. Moving sign-in to Firebase Auth is the fix; see README.
service cloud.firestore {
  match /databases/{database}/documents {
    function idMatches(docId) {
      return request.resource != null && request.resource.data.id == docId;
    }

    match /services/{docId}  { allow read, delete: if true; allow write: if idMatches(docId); }
    match /addons/{docId}    { allow read, delete: if true; allow write: if idMatches(docId); }
    match /inquiries/{docId} { allow read, delete: if true; allow write: if idMatches(docId); }
    match /users/{docId}     { allow read, delete: if true; allow write: if idMatches(docId); }
    match /admins/{docId}    { allow read, delete: if true; allow write: if idMatches(docId); }
    match /settings/{docId}  { allow read, delete: if true; allow write: if idMatches(docId); }
    match /activity/{docId}  { allow read, delete: if true; allow write: if idMatches(docId); }

    match /{document=**} { allow read, write: if false; }
  }
}
